        {
          "id": "4d03779e-faa8-4405-829b-9440a481ff34",
          "name": "Triggers a synchronization of cards via debiX PUSH.",
          "request": {
            "name": "Triggers a synchronization of cards via debiX PUSH.",
            "description": {
              "content": "The current state of the cards matching the provided filter criteria are send via debiX PUSH to the bank. The filter may not select more than 150'000 cards. \n\nIn addition to standard application error codes, the following codes can be returned:\n* 4525 - TOO_MANY_RESULTS\n* 4484 - BANK_CARDS_NOT_SUPPORTED_BY_ISSUER\n",
              "type": "text/plain"
            },
            "url": {
